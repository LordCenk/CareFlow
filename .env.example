# CareFlow Environment Configuration Template
# Copy this file to .env and configure your secrets

# Server Port
PORT=8080

# Spring Profiles: 'dev' for in-memory H2 (MySQL Mode), 'prod' for MySQL 8.4
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Required for 'prod' profile or Docker Compose)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=careflow
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_db_root_password

# Spring Datasource URLs (Mapped to application.yml)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/careflow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT Security Configuration
# Secret key must be at least 256 bits (32 characters) long for HMAC-SHA256
JWT_SECRET=your_jwt_secret_key_must_be_at_least_256_bits_long_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# Appointment Scheduling Policies
CANCELLATION_DEADLINE_HOURS=2
MAX_ADVANCE_BOOKING_DAYS=60
REMINDER_HOURS_AHEAD=24

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
